# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=haltia-music
pkgver=2.2.1
pkgrel=0
pkgdesc="Музыка: Яндекс Музыка with its radio, collection, charts and search (Haltia, GTK 3)"
url="https://github.com/haltia-de/music"
# b8k-music until 2.0: apk upgrade takes this for it.
provides="b8k-music=$pkgver-r$pkgrel"
replaces="b8k-music"
arch="noarch"
license="GPL-2.0-only"
depends="python3 py3-gobject3 gtk+3.0 libsecret py3-haltia-kit py3-mpv mpv-libs py3-aiohttp py3-aiofiles py3-yarl py3-requests py3-typing-extensions py3-qrcode"
# install.sh fetches the pinned yandex-music and ya-passport-auth wheels.
options="net"
# The MPRIS tests run on a bus of their own.
checkdepends="dbus"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/music/archive/v$pkgver.tar.gz"
# GitHub names the tarball's folder after the repository, not the package.
builddir="$srcdir/music-$pkgver"

check() {
	python3 -m unittest
}

package() {
	HALTIA_CACHE="$srcdir" sh ./install.sh "$pkgdir" /usr
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
