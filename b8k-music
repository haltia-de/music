    def drop_views(self):
        for view in self.views + list(self.roots.values()):
            self.drop(view)
        self.views, self.roots, self.radio_view = [], {}, None

    @staticmethod
    def drop(view):
        if view.get("alive"):
            view["alive"] = False
            view["page"].destroy()

    def go_root(self, section):
        root = self.roots.get(section)
        if root is not None and self.views == [root]:
            if section == "home":
                self.refresh_home(root)  # the house again: fresh rows
            return
        for view in self.views[1:]:
            self.drop(view)
        if root is None:
            root = self.roots[section] = ({"kind": "home"} if section == "home" else
                                          {"kind": "browse", "id": "", "title": "Обзор"})
            self.views = [root]
            self.make_page(root)
        else:
            self.views = [root]
        self.show_top()

    def push(self, view):
        self.views.append(view)
        self.make_page(view)
        self.show_top()

    def go_back(self):
        if len(self.views) > 1:
            self.drop(self.views.pop())
            self.show_top()

    def show_top(self):
        view = self.views[-1]
        self.stack.set_visible_child(view["page"])
        self.show_nav(True)
        root = self.views[0]["kind"]
        for btn, section in ((self.home_btn, "home"), (self.browse_btn, "browse")):
            ctx = btn.get_style_context()
            (ctx.add_class if root == section else ctx.remove_class)("current")
        self.update_hearts(view)
        self.mark_playing(view)

    def make_page(self, view):
        """Build the view's page into the stack and fill it."""
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        scroll.add(box)
        top = Gtk.Box(spacing=16)
        if view.get("title"):
            head = styled(Gtk.Label(label=view["title"], xalign=0), "head")
            head.set_ellipsize(Pango.EllipsizeMode.END)
            top.pack_start(head, True, True, 0)
        play = None
        if view["kind"] in ("list", "search", "radio"):
            play = styled(Gtk.Button(label="▶ Слушать"), "play")
            play.connect("clicked", lambda _b, v=view: self.listen(v))
            play.set_no_show_all(True)
            top.pack_end(play, False, False, 0)
        box.pack_start(top, False, False, 0)
        note = styled(Gtk.Label(), "note")
        note.set_line_wrap(True)
        note.set_no_show_all(True)
        box.pack_start(note, False, False, 8)
        lst = None
        if view["kind"] == "settings":
            self.settings_page(view, box)
        elif view["kind"] != "home":
            lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lst.connect("row-activated", self.on_row, view)
            box.pack_start(lst, False, False, 0)
        more = None
        if view["kind"] == "radio":
            more = styled(Gtk.Label(label="Дальше радио подберёт новые треки само: они "
                                          "появятся внизу списка, пока оно играет.", xalign=0),
                          "note")
            more.set_line_wrap(True)
            more.set_no_show_all(True)
            box.pack_start(more, False, False, 8)
        view.update(page=scroll, box=box, note=note, list=lst, play=play, more=more, shown=[],
                    hearts=[], alive=True)
        self.stack.add(scroll)
        scroll.show_all()
        self.load_view(view)

    def say(self, text, view=None):
        view = view or (self.views[-1] if self.views else None)
        if view and view.get("alive"):
            view["note"].set_text(text)
            view["note"].set_visible(bool(text))

    def load_view(self, view):
        k = view["kind"]
        if k == "settings":
            return
        if k == "home":
            self.say("Загружаю…", view)
            self.answers.get("home", None, lambda rows, err: self._home(view, rows, err))
        elif k == "radio":
            if self.radio_on(view):
                self.radio_view = view
                self.fill(view, list(self.session.tracks))
            else:
                # Its first tracks, shown as a list's are; they play only when asked.
                self.say("Загружаю…", view)
                self.work(lambda r: self.src.radio_next(r, None), view["id"],
                          lambda tracks, err: self._radio_first(view, tracks, err))
        elif view.get("items") is not None:
            self._items(view, view["items"], None)
        else:
            what, arg = {"browse": ("browse", view.get("id")), "list": ("tracks", view.get("id")),
                         "search": ("search", view.get("query"))}[k]
            self.say("Ищу…" if k == "search" else "Загружаю…", view)
            self.answers.get(what, arg, lambda items, err: self._items(view, items, err))

    def _items(self, view, items, error):
        if view["kind"] == "search":
            self.find_btn.set_sensitive(True)
        if not view.get("alive"):
            return
        if error:
            self.say("Не удалось загрузить: нет связи или вход устарел.", view)
            return
        empty = "Ничего не найдено." if view["kind"] == "search" else "Здесь пока пусто."
        self.say("" if items else empty, view)
        self.fill(view, items)
        if view.get("focus"):
            self.focus(view, view.pop("focus"))

    def focus(self, view, track_id):
        """Scroll the page to the track and mark it, once it is laid out."""
        rows = [r for r in view["list"].get_children()
                if kind(view["shown"][r.track_index]) == "track"
                and view["shown"][r.track_index]["id"] == track_id]
        if not rows:
            return
        styled(rows[0], "focus")
        tries = [20]

        def scroll():
            if not view.get("alive"):
                return False
            pos = rows[0].translate_coordinates(view["box"], 0, 0)
            if (not pos or pos[1] <= 0) and tries[0] > 0:
                tries[0] -= 1
                return True
            view["page"].get_vadjustment().set_value(max(0, pos[1] - 8) if pos else 0)
            return False

        GLib.timeout_add(50, scroll)

    def search(self):
        query = self.entry.get_text().strip()
        if not query or not self.find_btn.get_sensitive():
            return
        self.win.set_focus(None)
        self.find_btn.set_sensitive(False)
        self.push({"kind": "search", "query": query, "title": "Поиск: «%s»" % query})

    def open_item(self, item, row=None, tracks=None):
        """Open what was tapped; music never starts from here."""
        k = kind(item)
        if k == "track":
            # A track on the home page opens its row's list at the track.
            view = {"kind": "list", "title": row["title"] if row else "", "focus": item["id"]}
            if row and row.get("list"):
                view["id"] = row["list"]
            else:
                view["items"] = tracks or [item]
            self.push(view)
        elif k == "radio":
            self.push({"kind": "radio", "id": item["id"], "title": item["title"]})
        else:
            self.push({"kind": "browse" if k == "folder" else "list",
                       "id": item["id"], "title": item["title"]})

    def listen(self, view):
        """«▶ Слушать»: a list from its first track, or the radio."""
        if view["kind"] == "radio":
            self.play_radio(view, 0)
            return
        tracks = [t for t in view["shown"] if kind(t) == "track"]
        if tracks:
            self.play_list(tracks, 0)

    # --- the settings -------------------------------------------------------------
    def open_settings(self):
        if self.views[-1]["kind"] != "settings":
            self.push({"kind": "settings", "title": "Настройки"})

    def settings_page(self, view, box):
        box.pack_start(styled(Gtk.Label(label="Аккаунт", xalign=0), "section"),
                       False, False, 0)
        row = styled(Gtk.Box(spacing=16), "account")
        name = self.src.account()
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        text.set_valign(Gtk.Align.CENTER)
        text.pack_start(styled(Gtk.Label(label=self.src.label, xalign=0), "ttl"), False, False, 0)
        if name:
            text.pack_start(styled(Gtk.Label(label=name, xalign=0), "sub"), False, False, 0)
        row.pack_start(text, True, True, 0)
        out = styled(Gtk.Button(label="Выйти"), "quiet")
        out.set_valign(Gtk.Align.CENTER)
        out.connect("clicked", lambda *_a: self.logout())
        row.pack_end(out, False, False, 0)
        box.pack_start(row, False, False, 0)
        view["choices"] = []
        if not self.qualities:
            return
        box.pack_start(styled(Gtk.Label(label="Качество звука", xalign=0), "section"),
                       False, False, 8)
        choices = []
        for qid, title, hint in self.qualities:
            btn = styled(Gtk.Button(), "choice")
            row = Gtk.Box(spacing=16)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            text.pack_start(styled(Gtk.Label(label=title, xalign=0), "ttl"), False, False, 0)
            text.pack_start(styled(Gtk.Label(label=hint, xalign=0), "sub"), False, False, 0)
            row.pack_start(text, True, True, 0)
            mark = styled(Gtk.Label(label="✓"), "mark")
            row.pack_end(mark, False, False, 0)
            btn.add(row)
            btn.connect("clicked", lambda _b, q=qid: self.set_quality(view, q))
            box.pack_start(btn, False, False, 0)
            choices.append((qid, btn, mark))
        view["choices"] = choices
        self.mark_quality(view)

    def mark_quality(self, view):
        for qid, btn, mark in view["choices"]:
            ctx = btn.get_style_context()
            (ctx.add_class if qid == self.quality else ctx.remove_class)("current")
            mark.set_opacity(1 if qid == self.quality else 0)

    def set_quality(self, view, quality):
        if quality == self.quality:
            return
        self.quality = self.session.quality = quality
        save_setting("quality", quality)
        self.mark_quality(view)
        if self.session.current:
            self.say("Новое качество — со следующего трека.", view)

    # --- the home page --------------------------------------------------------
    def _home(self, view, rows, error):
        if not view.get("alive"):
            return
        if error or not rows:
            self.say("Не удалось загрузить: нет связи или вход устарел.", view)
            return
        self.say("", view)
        if view.get("rows") == rows:
            return
        for section in view.get("sections", {}).values():
            section.destroy()
        view["rows"], view["sections"], view["shows"] = rows, {}, {}
        for row in rows:
            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            section.set_no_show_all(True)
            section.pack_start(styled(Gtk.Label(label=row["title"], xalign=0), "rowtitle"),
                               False, False, 0)
            strip = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER)
            cards = Gtk.Box(spacing=12)
            strip.add(cards)
            section.pack_start(strip, False, False, 0)
            view["box"].pack_start(section, False, False, 4)
            view["sections"][row["id"]] = section
            show = view["shows"][row["id"]] = (
                lambda items, err, r=row, s=section, c=cards: self._home_row(view, r, s, c,
                                                                            items, err))
            self.answers.get("home_row", row["id"], show)

    def refresh_home(self, view):
        view["page"].get_vadjustment().set_value(0)
        self.likes.refresh(force=True)
        for row in view.get("rows") or []:
            self.answers.get("home_row", row["id"], view["shows"][row["id"]], force=True)

    def _home_row(self, view, row, section, cards, items, error):
        if not view.get("alive") or error:
            return
        clear(cards)
        if not items:
            section.hide()
            return
        tracks = [i for i in items if kind(i) == "track"]
        for item in items:
            btn = styled(Gtk.Button(), "card")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.cover(item, CARD, 56), False, False, 0)
            ttl = styled(Gtk.Label(label=item["title"], xalign=0), "ttl")
            ttl.set_line_wrap(True)
            ttl.set_lines(2)
            ttl.set_ellipsize(Pango.EllipsizeMode.END)
            ttl.set_max_width_chars(1)
            ttl.set_size_request(CARD, -1)
            box.pack_start(ttl, False, False, 0)
            sub_text = item.get("artist") if kind(item) == "track" else item.get("subtitle")
            if sub_text:
                sub = styled(Gtk.Label(label=sub_text, xalign=0), "sub")
                sub.set_ellipsize(Pango.EllipsizeMode.END)
                sub.set_max_width_chars(1)
                box.pack_start(sub, False, False, 0)
            btn.add(box)
            btn.connect("clicked", lambda _b, i=item: self.open_item(i, row, tracks))
            cards.pack_start(btn, False, False, 0)
        section.set_no_show_all(False)
        section.show_all()

    def cover(self, item, size, glyph_px):
        if item.get("cover"):
            image = Gtk.Image()
            image.set_size_request(size, size)
            self.covers.get(item["cover"], image, size)
            return image
        # A radio with a sign of its own gets a colour of its own, the same
        # each time; Мне нравится is red.
        likes_list = getattr(self.src, "likes_list", None)
        tint = "like" if likes_list and item.get("id") == likes_list else (
            "c%d" % (sum(map(ord, item["id"])) % 6) if kind(item) == "radio" and item.get("glyph")
            else kind(item))
        box = styled(Gtk.Box(), "nocover", tint)
        box.set_size_request(size, size)
        label = Gtk.Label()
        label.set_markup('<span size="%d">%s</span>'
                         % (glyph_px * 768, item.get("glyph") or GLYPHS[kind(item)]))
        box.set_center_widget(label)
        return box

    # --- the lists --------------------------------------------------------------
    def fill(self, view, items):
        view["shown"] = items
        view["hearts"] = []
        clear(view["list"])
        self.add_rows(view, items, 0)
        if view["play"] is not None:
            has_tracks = any(kind(t) == "track" for t in items)
            view["play"].set_visible(has_tracks and not (view["kind"] == "radio"
                                                         and self.radio_on(view)))
        if view.get("more") is not None:
            view["more"].set_visible(bool(items))
        self.update_hearts(view)
        self.mark_playing(view)

    def add_rows(self, view, items, first):
        """Rows for items, the first of them shown[first]."""
        lst = view["list"]
        for i, t in enumerate(items, first):
            row = Gtk.ListBoxRow()
            row.track_index = i
            box = Gtk.Box(spacing=16)
            box.pack_start(self.cover(t, 64, 28), False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            text.set_valign(Gtk.Align.CENTER)
            ttl = styled(Gtk.Label(label=t["title"], xalign=0), "ttl")
            ttl.set_ellipsize(Pango.EllipsizeMode.END)
            text.pack_start(ttl, False, False, 0)
            sub_text = t.get("artist") if kind(t) == "track" else t.get("subtitle")
            if sub_text:
                sub = styled(Gtk.Label(label=sub_text, xalign=0), "sub")
                sub.set_ellipsize(Pango.EllipsizeMode.END)
                text.pack_start(sub, False, False, 0)
            box.pack_start(text, True, True, 0)
            if kind(t) == "track":
                dur = styled(Gtk.Label(label=mmss(t.get("duration"))), "sub")
                box.pack_start(dur, False, False, 0)
                if self.likes.able:
                    heart = styled(Gtk.Button(), "heart")
                    heart.set_valign(Gtk.Align.CENTER)
                    heart.connect("clicked", lambda _b, tr=t: self.likes.toggle(tr))
                    view["hearts"].append((heart, t))
                    box.pack_start(heart, False, False, 0)
            else:
                more = styled(Gtk.Label(label="▶" if kind(t) == "radio" else "›"), "more")
                box.pack_start(more, False, False, 8)
            row.add(box)
            lst.add(row)
        lst.show_all()

    def radio_on(self, view):
        return (view["kind"] == "radio" and self.session.radio == view.get("id")
                and bool(self.session.tracks))

    def on_row(self, _list, row, view):
        i = row.track_index
        item = view["shown"][i]
        if kind(item) != "track":
            self.open_item(item)
            return
        if view["kind"] == "radio":
            self.play_radio(view, i)
            return
        # A tap on a track plays the list's tracks from this one on.
        tracks = [t for t in view["shown"] if kind(t) == "track"]
        before = sum(1 for t in view["shown"][:i] if kind(t) == "track")
        self.play_list(tracks, before)

    def open_views(self, view=None):
        return [view] if view else [v for v in self.views if v.get("alive")]

    def mark_playing(self, view=None):
        current = self.session.current
        for v in self.open_views(view):
            if not v.get("list"):
                continue
            for row in v["list"].get_children():
                t = v["shown"][row.track_index] if row.track_index < len(v["shown"]) else None
                same = (current and t and kind(t) == "track" and t["id"] == current["id"]
                        and t["source"] == current["source"])
                ctx = row.get_style_context()
                (ctx.add_class if same else ctx.remove_class)("playing")

    # --- what one likes ---------------------------------------------------------
    def set_heart(self, btn, track):
        on = self.likes.liked(track)
        btn.set_label("♥" if on else "♡")
        ctx = btn.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("on")

    def update_hearts(self, view=None):
        for v in self.open_views(view):
            for btn, track in v.get("hearts", []):
                self.set_heart(btn, track)
        if self.likes.able and self.bar:
            self.set_heart(self.bar_heart, self.session.current)

    # --- the bar ----------------------------------------------------------------
    def make_bar(self):
        bar = styled(Gtk.Box(spacing=16), "bar")
        self.bar_cover = Gtk.Image()
        self.bar_cover.set_size_request(96, 96)
        bar.pack_start(self.bar_cover, False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.bar_title = styled(Gtk.Label(xalign=0), "ttl")
        self.bar_title.set_ellipsize(Pango.EllipsizeMode.END)
        self.bar_artist = styled(Gtk.Label(xalign=0), "sub")
        self.bar_artist.set_ellipsize(Pango.EllipsizeMode.END)
        mid.pack_start(self.bar_title, False, False, 0)
        mid.pack_start(self.bar_artist, False, False, 0)
        line = Gtk.Box(spacing=8)
        self.bar_pos = styled(Gtk.Label(label="0:00"), "time")
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.scale.set_draw_value(False)
        self.scale.connect("button-press-event", lambda *_a: setattr(self, "seeking", True))
        self.scale.connect("button-release-event", self.on_seek)
        self.bar_len = styled(Gtk.Label(label="0:00"), "time")
        line.pack_start(self.bar_pos, False, False, 0)
        line.pack_start(self.scale, True, True, 0)
        line.pack_start(self.bar_len, False, False, 0)
        mid.pack_start(line, False, False, 0)
        bar.pack_start(mid, True, True, 0)
        self.bar_heart = styled(Gtk.Button(label="♡"), "heart")
        self.bar_heart.set_valign(Gtk.Align.CENTER)
        self.bar_heart.connect("clicked", lambda *_a: self.likes.toggle(self.session.current))
        self.bar_heart.set_no_show_all(not self.likes.able)
        bar.pack_start(self.bar_heart, False, False, 0)
        for label, cls, cb in (("⏮", "ctl", self.session.prev),
                               ("▶", "ctl main", self.session.toggle),
                               ("⏭", "ctl", self.session.next)):
            btn = styled(Gtk.Button(label=label), *cls.split())
            btn.set_valign(Gtk.Align.CENTER)
            btn.connect("clicked", lambda *_a, f=cb: f())
            bar.pack_start(btn, False, False, 0)
            if "main" in cls:
                self.play_btn = btn
        self.bar = bar
        return bar

    def on_seek(self, *_a):
        self.seeking = False
        self.session.seek(self.scale.get_value())
        return False

    # --- playing ----------------------------------------------------------------
    def play_list(self, tracks, i):
        self.radio_view = None
        self.session.play_list(tracks, i)
        for view in self.open_views():
            if view["kind"] == "radio":
                view["play"].show()

    def _radio_first(self, view, tracks, error):
        if not view.get("alive") or self.radio_on(view):
            return
        if error or not tracks:
            self.say("Радио не загрузилось: нет связи?", view)
            return
        self.say("", view)
        self.fill(view, list(tracks))

    def play_radio(self, view, i):
        """Play the radio of the page from its i-th track; what comes next
        is added to the page as it comes."""
        if self.radio_on(view):
            self.session.jump(i)
            return
        if not view["shown"]:
            return
        self.radio_view = view
        self.session.play_radio(view["id"], view["shown"], i)
        view["play"].hide()

    def on_track(self, track):
        if track is None:
            if self.bar:
                self.bar.hide()
            return
        self.bar.show()
        self.bar_title.set_text(track["title"])
        self.bar_artist.set_text(track["artist"])
        duration = track.get("duration") or 0
        self.scale.set_range(0, max(1, duration))
        self.bar_len.set_text(mmss(duration))
        self.bar_pos.set_text("0:00")
        self.bar_cover.clear()
        self.covers.get(track.get("cover"), self.bar_cover, 96)
        self.mark_playing()
        self.update_hearts()

    def on_grew(self, tracks):
        view = self.radio_view
        if view and view.get("alive") and self.radio_on(view):
            first = len(view["shown"])
            view["shown"].extend(tracks)
            self.add_rows(view, tracks, first)
            self.update_hearts(view)

    def on_time(self, value):
        if value is None:
            return False
        if not self.seeking:
            self.scale.set_value(value)
        self.bar_pos.set_text(mmss(value))
        return False

    def on_playing(self, on):
        if self.bar:
            self.play_btn.set_label("⏸" if on else "▶")

    def stop(self):
        self.session.stop()
        self.radio_view = None

    def do_shutdown(self):
        self.answers.flush()
        if self.awake and os.path.exists(self.awake):
            os.unlink(self.awake)
        Gtk.Application.do_shutdown(self)

    # --- background work -------------------------------------------------------
    def later(self, sec, func):
        GLib.timeout_add(int(sec * 1000), lambda: (func(), False)[1])

    def work(self, func, arg, done):
        """func(arg) in a thread; done(result, error) back on the GTK side."""

        def worker():
            try:
                res, err = func(arg), None
            except Exception as exc:
                sys.stderr.write("b8k-music: %s\n" % exc)
                res, err = None, exc
            if done:
                GLib.idle_add(lambda: (done(res, err), False)[1])

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    sys.exit(Music().run(sys.argv))
