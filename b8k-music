        self.quality = load_setting("quality", self.qualities[0][0] if self.qualities else "")
        self.answers = answers.Answers(self.src, self.work, self.later, DATA)
        self.likes = likes.Likes(self.src, self.answers, self.work,
                                 lambda: self.update_hearts(), self.say)
        # Where one is: the section's root first, then what was opened in it.
        # A view is a dict; its page and widgets live in it while it is open.
        self.views = []
        self.roots = {}
        self.bar = None
        self.radio_view = None  # the page that shows the radio playing
        self.seeking = False
