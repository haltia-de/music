def qr_code(text, size):
    """The QR code of text, size pixels square, or None without qrcode."""
    try:
        import qrcode

        code = qrcode.QRCode(border=2, error_correction=qrcode.constants.ERROR_CORRECT_M)
        code.add_data(text)
        code.make(fit=True)
        matrix = code.get_matrix()
    except Exception as exc:
        sys.stderr.write("b8k-music: no QR code: %s\n" % exc)
        return None
    cell = size // len(matrix)
    off = (size - cell * len(matrix)) // 2

    def draw(_area, cr):
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        cr.set_source_rgb(0, 0, 0)
        for y, row in enumerate(matrix):
            for x, dark in enumerate(row):
                if dark:
                    cr.rectangle(off + x * cell, off + y * cell, cell, cell)
        cr.fill()
        return False

    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    area.set_halign(Gtk.Align.CENTER)
    area.connect("draw", draw)
    return area


class Covers:
    """Album covers, fetched by a few workers and kept on disk."""

    def __init__(self):
        self.pool = ThreadPoolExecutor(max_workers=3)
        os.makedirs(CACHE, exist_ok=True)

    def get(self, url, image, size):
        if not url:
            return
        path = os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest() + ".jpg")
        if os.path.exists(path):
            self._show(path, image, size)
        else:
            self.pool.submit(self._fetch, url, path, image, size)

    def _fetch(self, url, path, image, size):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=20) as resp:
                data = resp.read(512 * 1024)
            with open(path + ".new", "wb") as fh:
                fh.write(data)
            os.replace(path + ".new", path)
        except OSError:
            return
        GLib.idle_add(self._show, path, image, size)

    @staticmethod
    def _show(path, image, size):
        try:
            image.set_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(path, size, size, True))
        except GLib.Error:
            pass
        return False


class Player:
    """libmpv, sound only. Callbacks come back on the GTK side."""

    def __init__(self, on_end, on_time, on_pause):
        import mpv

        self.mpv = mpv.MPV(video=False, ytdl=False, input_default_bindings=False,
                           terminal=False, cache="yes", demuxer_max_bytes="16MiB")
        self.on_end, self.on_time, self.on_pause = on_end, on_time, on_pause
        self.mpv.observe_property("time-pos", lambda _n, v: GLib.idle_add(self.on_time, v))
        self.mpv.observe_property("pause", lambda _n, v: GLib.idle_add(self.on_pause, v))

        @self.mpv.event_callback("end-file")
        def _end(event):
            data = getattr(event, "data", None)
            reason = getattr(data, "reason", None)
            # 0 is the end of the file; a new loadfile also ends the old one.
            if reason in (0, "eof", b"eof") or str(reason).endswith("EOF"):
                GLib.idle_add(self.on_end)

    def play(self, url):
        self.mpv.play(url)
        self.mpv.pause = False

    def toggle(self):
        self.mpv.pause = not self.mpv.pause

    def seek(self, sec):
        try:
            self.mpv.seek(sec, reference="absolute")
        except Exception:
            pass

    def time(self):
        try:
            return self.mpv.time_pos or 0
        except Exception:
            return 0


