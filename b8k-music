        self.page.show_all()
        self.work(lambda _a: self.src.login_wait(), None, self._login_done)

    def _login_done(self, ok, error):
        if error or not ok:
            self.note_only("Вход не подтверждён.")
            GLib.timeout_add_seconds(4, lambda: (self.show_login(), False)[1])
            return
        self.show_main()

    def logout(self):
        def worker():
            if ask("Выйти из %s?" % self.src.label, "Выйти"):
                GLib.idle_add(self._logout)

        threading.Thread(target=worker, daemon=True).start()

    def _logout(self):
        self.stop()
        self.src.logout()
        self.likes.reset()
        self.answers.reset()
        self.show_login()
        return False

    # --- the pages --------------------------------------------------------------
    def show_main(self):
