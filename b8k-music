    # --- signing in -----------------------------------------------------------
    def show_login(self):
        self.show_nav(False)
        self.clear_page()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
        box.set_valign(Gtk.Align.CENTER)
        label = styled(Gtk.Label(label="Войдите в %s, чтобы слушать музыку." % self.src.label),
