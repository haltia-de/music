    def login(self):
        self.note_only("Получаю код…")
        self.work(lambda _a: self.src.login_start(), None, self._login_code)

    def _login_code(self, res, error):
        qr = res and res.get("qr") and qr_code(res["qr"], QR)
        if error or not res or not (qr or res.get("code")):
            self.note_only("Не удалось начать вход: нет связи?")
            GLib.timeout_add_seconds(4, lambda: (self.show_login(), False)[1])
            return
        self.clear_page()
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=32)
        outer.set_valign(Gtk.Align.CENTER)
        ways = Gtk.Box(spacing=64)
        ways.set_halign(Gtk.Align.CENTER)
        if qr:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            col.set_valign(Gtk.Align.CENTER)
            col.pack_start(qr, False, False, 0)
            col.pack_start(styled(Gtk.Label(label="Наведите камеру телефона"), "note"),
                           False, False, 0)
            ways.pack_start(col, False, False, 0)
        if res.get("code"):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
            col.set_valign(Gtk.Align.CENTER)
            first = "или откройте" if qr else "На телефоне или компьютере откройте"
            url = res["url"].replace("https://", "")
