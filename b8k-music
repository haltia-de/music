def mmss(sec):
    if not sec or sec < 0:
        return "0:00"
    sec = int(sec)
    return "%d:%02d" % (sec // 60, sec % 60)


def load_setting(key, default):
    """A setting of [music] in CONFIG."""
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    return conf.get("music", key, fallback=default)


def save_setting(key, value):
    conf = configparser.ConfigParser(interpolation=None)
    conf.read(CONFIG, encoding="utf-8")
    if not conf.has_section("music"):
        conf.add_section("music")
    conf["music"][key] = value
    try:
        os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
        with open(CONFIG + ".new", "w", encoding="utf-8") as fh:
            conf.write(fh)
        os.replace(CONFIG + ".new", CONFIG)
    except OSError:
        pass


