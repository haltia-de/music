        btn.connect("clicked", lambda *_a: self.login())
        box.pack_start(btn, False, False, 0)
        self.page.pack_start(box, True, True, 0)
        self.page.show_all()

    def login(self):
        self.note_only("Получаю код…")
        self.work(lambda _a: self.src.login_start(), None, self._login_code)

    def _login_code(self, res, error):
        qr = res and res.get("qr") and qr_code(res["qr"], QR)
        if error or not res or not (qr or res.get("code")):
            self.note_only("Не удалось начать вход: нет связи?")
            GLib.timeout_add_seconds(4, lambda: (self.show_login(), False)[1])
            return
        self.clear_page()
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=32)
        outer.set_valign(Gtk.Align.CENTER)
        ways = Gtk.Box(spacing=64)
        ways.set_halign(Gtk.Align.CENTER)
        if qr:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            col.set_valign(Gtk.Align.CENTER)
            col.pack_start(qr, False, False, 0)
            col.pack_start(styled(Gtk.Label(label="Наведите камеру телефона"), "note"),
                           False, False, 0)
            ways.pack_start(col, False, False, 0)
        if res.get("code"):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
            col.set_valign(Gtk.Align.CENTER)
            first = "или откройте" if qr else "На телефоне или компьютере откройте"
            url = res["url"].replace("https://", "")
            for text, cls in ((first, "note"), (url, "code"), ("и введите код", "note"),
                              (res["code"], "code")):
                col.pack_start(styled(Gtk.Label(label=text), cls), False, False, 0)
            ways.pack_start(col, False, False, 0)
        outer.pack_start(ways, False, False, 0)
        outer.pack_start(styled(Gtk.Label(label="Жду подтверждения…"), "note"), False, False, 0)
        self.page.pack_start(outer, True, True, 0)
        self.page.show_all()
        self.work(lambda _a: self.src.login_wait(), None, self._login_done)

    def _login_done(self, ok, error):
        if error or not ok:
            self.note_only("Вход не подтверждён.")
            GLib.timeout_add_seconds(4, lambda: (self.show_login(), False)[1])
            return
        self.show_main()

    def logout(self):
        def worker():
            if ask("Выйти из %s?" % self.src.label, "Выйти"):
                GLib.idle_add(self._logout)

        threading.Thread(target=worker, daemon=True).start()

    def _logout(self):
        self.stop()
        self.src.logout()
        self.home_rows, self.home_items, self.liked = None, {}, set()
        self.views = []
        self.show_login()
        return False

    # --- the main page --------------------------------------------------------
    def show_main(self):
        self.clear_page()
        row = Gtk.Box(spacing=12)
        self.entry = styled(Gtk.Entry(placeholder_text="Найти трек или исполнителя"), "search")
        self.entry.connect("activate", lambda *_a: self.search())
        row.pack_start(self.entry, True, True, 0)
        self.find_btn = styled(Gtk.Button(label="Найти"), "find")
        self.find_btn.connect("clicked", lambda *_a: self.search())
        row.pack_start(self.find_btn, False, False, 0)
        self.page.pack_start(row, False, False, 0)

        # Everything under the search scrolls together: anything tall outside
        # the scrolled part keeps the window taller than the room the
        # on-screen keyboard leaves, and the window then covers its top row.
        self.scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.scroll.add(self.body)
        self.page.pack_start(self.scroll, True, True, 0)
        self.page.show_all()
        self.win.set_focus(None)
        if self.can_like:
            self.work(lambda _a: self.src.liked(), None, self._liked)
        self.go_root("home")

    def say(self, text):
        if self.note:
            self.note.set_text(text)
            self.note.set_visible(bool(text))

    def go_root(self, section):
        if self.views == [{"kind": "home"}] and section == "home":
            self.home_rows, self.home_items = None, {}  # the house again: fresh rows
        self.views = [{"kind": "home"} if section == "home"
                      else {"kind": "browse", "id": "", "title": "Обзор"}]
        self.render()

    def push(self, view):
        self.views.append(view)
        self.render()

    def go_back(self):
        if len(self.views) > 1:
            self.views.pop()
            self.render()

    def render(self):
        """Draw the page of the last view."""
        self.gen += 1
        for child in self.body.get_children():
            self.body.remove(child)
            child.destroy()
        self.list, self.note, self.hearts, self.shown = None, None, [], []
        self.show_nav(True)
        root = self.views[0]["kind"]
        for btn, section in ((self.home_btn, "home"), (self.browse_btn, "browse")):
            ctx = btn.get_style_context()
            (ctx.add_class if root == section else ctx.remove_class)("current")
        self.scroll.get_vadjustment().set_value(0)
        view = self.views[-1]
        if view.get("title"):
            head = styled(Gtk.Label(label=view["title"], xalign=0), "head")
            head.set_ellipsize(Pango.EllipsizeMode.END)
            self.body.pack_start(head, False, False, 0)
        self.note = styled(Gtk.Label(), "note")
        self.note.set_line_wrap(True)
        self.body.pack_start(self.note, False, False, 8)
        if view["kind"] == "home":
            self.body.show_all()
            self.say("")
            self.render_home()
            return
        self.list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.list.connect("row-activated", self.on_row)
        self.body.pack_start(self.list, False, False, 0)
        self.body.show_all()
        self.say("")
        if view["kind"] == "queue":
            self.fill(self.queue)
            if not self.queue:
                self.say("Запускаю…" if self.radio else "Ничего не играет.")
            return
        if "items" in view:
            self.fill(view["items"])
            self.say("" if view["items"] else self.empty_text(view))
            return
        func, arg = {"browse": (self.src.browse, view.get("id")),
                     "list": (self.src.tracks, view.get("id")),
                     "search": (self.src.search, view.get("query"))}[view["kind"]]
        self.say("Ищу…" if view["kind"] == "search" else "Загружаю…")
        self.work(func, arg, lambda res, err, g=self.gen, v=view: self._loaded(v, g, res, err))

    @staticmethod
    def empty_text(view):
        return "Ничего не найдено." if view["kind"] == "search" else "Здесь пока пусто."

    def _loaded(self, view, gen, items, error):
        if view["kind"] == "search":
            self.find_btn.set_sensitive(True)
        if not error:
            view["items"] = items or []
        if gen != self.gen:
            return
        if error:
            self.say("Не удалось загрузить: нет связи или вход устарел.")
            return
        self.say("" if items else self.empty_text(view))
        self.fill(view["items"])

    def search(self):
        query = self.entry.get_text().strip()
        if not query or not self.find_btn.get_sensitive():
            return
        self.win.set_focus(None)
        self.find_btn.set_sensitive(False)
        self.push({"kind": "search", "query": query, "title": "Поиск: «%s»" % query})

    def open_item(self, item, tracks=None):
        k = kind(item)
        if k == "track":
            tracks = tracks or [item]
            self.play_list(tracks, tracks.index(item))
        elif k == "radio":
            self.start_radio(item)
            self.push({"kind": "queue", "title": item["title"]})
        else:
            self.push({"kind": "browse" if k == "folder" else "list",
                       "id": item["id"], "title": item["title"]})

    # --- the home page --------------------------------------------------------
    def render_home(self):
        if self.home_rows is None:
            self.say("Загружаю…")
            self.work(lambda _a: self.src.home(), None,
                      lambda rows, err, g=self.gen: self._home(g, rows, err))
            return
        for row in self.home_rows:
            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            section.set_no_show_all(True)
            section.pack_start(styled(Gtk.Label(label=row["title"], xalign=0), "rowtitle"),
                               False, False, 0)
            strip = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER)
            cards = Gtk.Box(spacing=12)
            strip.add(cards)
            section.pack_start(strip, False, False, 0)
            self.body.pack_start(section, False, False, 4)
            if row["id"] in self.home_items:
                self.fill_cards(section, cards, self.home_items[row["id"]])
            else:
                self.work(self.src.home_row, row["id"],
                          lambda items, err, r=row["id"], s=section, c=cards, g=self.gen:
                          self._home_row(g, r, s, c, items, err))

    def _home(self, gen, rows, error):
        if gen != self.gen:
            return
        if error or not rows:
            self.say("Не удалось загрузить: нет связи или вход устарел.")
            return
        self.say("")
        self.home_rows = rows
        self.render_home()

    def _home_row(self, gen, row_id, section, cards, items, error):
        if not error:
            self.home_items[row_id] = items or []
        if gen == self.gen and items:
            self.fill_cards(section, cards, items)

    def fill_cards(self, section, cards, items):
        if not items:
            return
        tracks = [i for i in items if kind(i) == "track"]
        for item in items:
            btn = styled(Gtk.Button(), "card")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.cover(item, CARD, 56), False, False, 0)
            ttl = styled(Gtk.Label(label=item["title"], xalign=0), "ttl")
            ttl.set_line_wrap(True)
            ttl.set_lines(2)
            ttl.set_ellipsize(Pango.EllipsizeMode.END)
            ttl.set_max_width_chars(1)
            ttl.set_size_request(CARD, -1)
            box.pack_start(ttl, False, False, 0)
            sub_text = item.get("artist") if kind(item) == "track" else item.get("subtitle")
            if sub_text:
                sub = styled(Gtk.Label(label=sub_text, xalign=0), "sub")
                sub.set_ellipsize(Pango.EllipsizeMode.END)
                sub.set_max_width_chars(1)
                box.pack_start(sub, False, False, 0)
            btn.add(box)
            btn.connect("clicked", lambda _b, i=item: self.open_item(i, tracks))
            cards.pack_start(btn, False, False, 0)
        section.set_no_show_all(False)
        section.show_all()

    def cover(self, item, size, glyph_px):
        if item.get("cover"):
            image = Gtk.Image()
            image.set_size_request(size, size)
            self.covers.get(item["cover"], image, size)
            return image
        # A radio with a sign of its own gets a colour of its own, the same
        # each time; Мне нравится is red.
        tint = "like" if item.get("id") == "likes" else (
            "c%d" % (sum(map(ord, item["id"])) % 6) if kind(item) == "radio" and item.get("glyph")
            else kind(item))
        box = styled(Gtk.Box(), "nocover", tint)
        box.set_size_request(size, size)
        label = Gtk.Label()
        label.set_markup('<span size="%d">%s</span>' % (glyph_px * 768, item.get("glyph") or GLYPHS[kind(item)]))
        box.set_center_widget(label)
        return box

    # --- the list ---------------------------------------------------------------
    def fill(self, items):
        # The very list, not a copy: a radio's list is its queue, which grows.
        self.shown = items
        self.hearts = []
        if self.list is None:
            return
        for child in self.list.get_children():
            self.list.remove(child)
            child.destroy()
        for i, t in enumerate(self.shown):
            row = Gtk.ListBoxRow()
            row.track_index = i
            box = Gtk.Box(spacing=16)
            box.pack_start(self.cover(t, 64, 28), False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            text.set_valign(Gtk.Align.CENTER)
            ttl = styled(Gtk.Label(label=t["title"], xalign=0), "ttl")
            ttl.set_ellipsize(Pango.EllipsizeMode.END)
            text.pack_start(ttl, False, False, 0)
            sub_text = t.get("artist") if kind(t) == "track" else t.get("subtitle")
            if sub_text:
                sub = styled(Gtk.Label(label=sub_text, xalign=0), "sub")
                sub.set_ellipsize(Pango.EllipsizeMode.END)
                text.pack_start(sub, False, False, 0)
            box.pack_start(text, True, True, 0)
            if kind(t) == "track":
                dur = styled(Gtk.Label(label=mmss(t.get("duration"))), "sub")
                box.pack_start(dur, False, False, 0)
                if self.can_like:
                    heart = styled(Gtk.Button(), "heart")
                    heart.set_valign(Gtk.Align.CENTER)
                    heart.connect("clicked", lambda _b, tr=t: self.toggle_like(tr))
                    self.hearts.append((heart, t))
                    box.pack_start(heart, False, False, 0)
            else:
                more = styled(Gtk.Label(label="▶" if kind(t) == "radio" else "›"), "more")
                box.pack_start(more, False, False, 8)
            row.add(box)
            self.list.add(row)
        self.list.show_all()
        self.update_hearts()
        self.mark_playing()

    def on_row(self, _list, row):
        i = row.track_index
        item = self.shown[i]
        if kind(item) != "track":
            self.open_item(item)
            return
        if self.radio and self.shown is self.queue:
            self.start(i)
            return
        # A tap in a list plays that list's tracks from this one on.
        tracks = [t for t in self.shown if kind(t) == "track"]
        if len(tracks) == len(self.shown):
            self.radio = None
            self.queue = list(self.shown)
            self.shown = self.queue
            self.start(i)
        else:
            self.play_list(tracks, tracks.index(item))

    def mark_playing(self):
        current = self.queue[self.index] if 0 <= self.index < len(self.queue) else None
        if self.list is None:
            return
        for row in self.list.get_children():
            t = self.shown[row.track_index] if row.track_index < len(self.shown) else None
            ctx = row.get_style_context()
            same = (current and t and kind(t) == "track" and t["id"] == current["id"]
                    and t["source"] == current["source"])
            (ctx.add_class if same else ctx.remove_class)("playing")

    # --- what one likes ---------------------------------------------------------
    def _liked(self, ids, error):
        if not error and ids is not None:
            self.liked = set(ids)
            self.update_hearts()

    def set_heart(self, btn, track):
        on = bool(track) and track["id"] in self.liked
        btn.set_label("♥" if on else "♡")
        ctx = btn.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("on")

    def update_hearts(self):
        for btn, track in self.hearts:
            self.set_heart(btn, track)
        if self.can_like:
            current = self.queue[self.index] if 0 <= self.index < len(self.queue) else None
            self.set_heart(self.bar_heart, current)

    def toggle_like(self, track):
        if not track:
            return
        on = track["id"] not in self.liked
        (self.liked.add if on else self.liked.discard)(track["id"])
        self.update_hearts()
        for view in self.views:
            if view.get("id") == "likes":
                view.pop("items", None)
        self.home_items.pop("mine", None)
        self.work(lambda _a: self.src.like(track, on), None,
                  lambda _r, err: self._like_done(track, on, err))

    def _like_done(self, track, on, error):
        if error:
            (self.liked.discard if on else self.liked.add)(track["id"])
            self.update_hearts()
            self.say("Не удалось отметить трек: нет связи?")

    # --- the bar ----------------------------------------------------------------
    def make_bar(self):
        bar = styled(Gtk.Box(spacing=16), "bar")
        self.bar_cover = Gtk.Image()
        self.bar_cover.set_size_request(96, 96)
        bar.pack_start(self.bar_cover, False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.bar_title = styled(Gtk.Label(xalign=0), "ttl")
        self.bar_title.set_ellipsize(Pango.EllipsizeMode.END)
        self.bar_artist = styled(Gtk.Label(xalign=0), "sub")
        self.bar_artist.set_ellipsize(Pango.EllipsizeMode.END)
        mid.pack_start(self.bar_title, False, False, 0)
        mid.pack_start(self.bar_artist, False, False, 0)
        line = Gtk.Box(spacing=8)
        self.bar_pos = styled(Gtk.Label(label="0:00"), "time")
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.scale.set_draw_value(False)
        self.scale.connect("button-press-event", lambda *_a: setattr(self, "seeking", True))
        self.scale.connect("button-release-event", self.on_seek)
        self.bar_len = styled(Gtk.Label(label="0:00"), "time")
        line.pack_start(self.bar_pos, False, False, 0)
        line.pack_start(self.scale, True, True, 0)
        line.pack_start(self.bar_len, False, False, 0)
        mid.pack_start(line, False, False, 0)
        bar.pack_start(mid, True, True, 0)
        self.bar_heart = styled(Gtk.Button(label="♡"), "heart")
        self.bar_heart.set_valign(Gtk.Align.CENTER)
        self.bar_heart.connect("clicked", lambda *_a: self.toggle_like(
            self.queue[self.index] if 0 <= self.index < len(self.queue) else None))
        self.bar_heart.set_no_show_all(not self.can_like)
        bar.pack_start(self.bar_heart, False, False, 0)
        for label, cls, cb in (("⏮", "ctl", self.prev), ("▶", "ctl main", self.toggle),
                               ("⏭", "ctl", self.next)):
            btn = styled(Gtk.Button(label=label), *cls.split())
            btn.set_valign(Gtk.Align.CENTER)
            btn.connect("clicked", lambda *_a, f=cb: f())
            bar.pack_start(btn, False, False, 0)
            if "main" in cls:
                self.play_btn = btn
        self.bar = bar
        return bar

    def on_seek(self, *_a):
        self.seeking = False
        if self.player:
            self.player.seek(self.scale.get_value())
        return False

    # --- playing ----------------------------------------------------------------
    def ensure_player(self):
        if self.player is None:
            self.player = Player(self.on_end, self.on_time, self.on_pause)
        return self.player

    def play_list(self, tracks, i):
        self.radio = None
        self.queue = list(tracks)
        self.start(i)

    def start_radio(self, item):
        if self.radio == item["id"] and self.queue:
            return  # it plays already: only its list is shown
        self.radio = item["id"]
        self.queue, self.index = [], -1
        self.work(lambda _a, r=item["id"]: self.src.radio_next(r, None), None,
                  lambda tracks, err, r=item["id"]: self._radio_first(r, tracks, err))

    def _radio_first(self, radio, tracks, error):
        if radio != self.radio:
            return  # another radio or list was chosen meanwhile
        if error or not tracks:
            self.radio = None
            self.say("Радио не запустилось: нет связи?")
            return
        self.queue = list(tracks)
        if self.views and self.views[-1]["kind"] == "queue":
            self.say("")
            self.fill(self.queue)
        self.start(0)

    def start(self, i):
        if not (0 <= i < len(self.queue)):
            return
        prev = self.queue[self.index] if 0 <= self.index < len(self.queue) else None
        if prev and self.radio and self.playing:
            played = self.player.time() if self.player else 0
            threading.Thread(target=self.src.feedback,
                             args=(self.radio, "skip", prev, played), daemon=True).start()
        self.index = i
        track = self.queue[i]
        self.bar.show()
        self.bar_title.set_text(track["title"])
        self.bar_artist.set_text(track["artist"])
        self.duration = track.get("duration") or 0
        self.scale.set_range(0, max(1, self.duration))
        self.bar_len.set_text(mmss(self.duration))
        self.bar_pos.set_text("0:00")
        self.bar_cover.clear()
        self.covers.get(track.get("cover"), self.bar_cover, 96)
        self.mark_playing()
        self.update_hearts()
        self.work(self.src.stream_url, track, lambda url, err, t=track: self._play(t, url, err))
        if self.radio:
            threading.Thread(target=self.src.feedback,
                             args=(self.radio, "start", track, 0), daemon=True).start()
            if len(self.queue) - i <= RADIO_AHEAD:
                self.work(lambda _a, r=self.radio, last=track: self.src.radio_next(r, last),
                          None, lambda tracks, err, r=self.radio: self._radio_more(r, tracks, err))

    def _play(self, track, url, error):
        if not (0 <= self.index < len(self.queue)) or self.queue[self.index] is not track:
            return  # another track was chosen meanwhile
        if error or not url:
            self.say("Трек не играет: %s" % (error or "нет ссылки"))
            GLib.timeout_add_seconds(2, lambda: (self.next(), False)[1])
            return
        try:
            self.ensure_player().play(url)
        except Exception as exc:
            self.say("Нет проигрывателя (libmpv): %s" % exc)
            return
        self.set_playing(True)

    def _radio_more(self, radio, tracks, error):
        if error or not tracks or radio != self.radio:
            return
        known = {t["id"] for t in self.queue}
        self.queue.extend(t for t in tracks if t["id"] not in known)
        if self.shown is self.queue:
            self.fill(self.queue)

    def on_end(self):
        track = self.queue[self.index] if 0 <= self.index < len(self.queue) else None
        if track and self.radio:
            threading.Thread(target=self.src.feedback,
                             args=(self.radio, "finish", track, self.duration),
                             daemon=True).start()
        if self.index + 1 < len(self.queue):
            self.playing = False  # the end was not a skip
            self.start(self.index + 1)
        else:
            self.set_playing(False)
        return False

    def on_time(self, value):
        if value is None:
            return False
        if not self.seeking:
            self.scale.set_value(value)
        self.bar_pos.set_text(mmss(value))
        return False

    def on_pause(self, paused):
        self.set_playing(not paused if paused is not None else False)
        return False

    def set_playing(self, on):
        self.playing = on
        self.play_btn.set_label("⏸" if on else "▶")
        if self.awake:
            try:
                if on:
                    open(self.awake, "w").close()
                elif os.path.exists(self.awake):
                    os.unlink(self.awake)
            except OSError:
                pass

    def toggle(self):
        if self.player and self.index >= 0:
            self.player.toggle()

    def next(self):
        if self.index + 1 < len(self.queue):
            self.start(self.index + 1)

    def prev(self):
        if self.player and self.player.time() > 5:
            self.player.seek(0)
        elif self.index > 0:
            self.start(self.index - 1)

    def stop(self):
        if self.player:
            try:
                self.player.mpv.stop()
            except Exception:
                pass
        self.queue, self.index, self.radio = [], -1, None
        self.set_playing(False)
        if self.bar:
            self.bar.hide()

    def do_shutdown(self):
        if self.awake and os.path.exists(self.awake):
            os.unlink(self.awake)
        Gtk.Application.do_shutdown(self)

    # --- background work -------------------------------------------------------
    def work(self, func, arg, done):
        """func(arg) in a thread; done(result, error) back on the GTK side."""

        def worker():
            try:
                res, err = func(arg), None
            except Exception as exc:
                sys.stderr.write("b8k-music: %s\n" % exc)
                res, err = None, exc
            GLib.idle_add(lambda: (done(res, err), False)[1])

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    sys.exit(Music().run(sys.argv))
