def mmss(sec):
    if not sec or sec < 0:
        return "0:00"
    sec = int(sec)
    return "%d:%02d" % (sec // 60, sec % 60)


def kind(item):
    return item.get("kind", "track")


def styled(widget, *classes):
    ctx = widget.get_style_context()
    for cls in classes:
        ctx.add_class(cls)
    return widget


def clear(box):
    for child in box.get_children():
        box.remove(child)
        child.destroy()


def qr_code(text, size):
    """The QR code of text, size pixels square, or None without qrcode."""
    try:
        import qrcode

        code = qrcode.QRCode(border=2, error_correction=qrcode.constants.ERROR_CORRECT_M)
        code.add_data(text)
        code.make(fit=True)
        matrix = code.get_matrix()
    except Exception as exc:
        sys.stderr.write("haltia-music: no QR code: %s\n" % exc)
        return None
    cell = size // len(matrix)
    off = (size - cell * len(matrix)) // 2

    def draw(_area, cr):
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        cr.set_source_rgb(0, 0, 0)
        for y, row in enumerate(matrix):
            for x, dark in enumerate(row):
                if dark:
                    cr.rectangle(off + x * cell, off + y * cell, cell, cell)
        cr.fill()
        return False

    area = Gtk.DrawingArea()
    area.set_size_request(size, size)
    area.set_halign(Gtk.Align.CENTER)
    area.connect("draw", draw)
    return area


class Covers:
    """Album covers: files on disk, decoded ones in memory. Fetching and
    decoding happen in workers, so the window never waits for them."""

    def __init__(self):
        self.disk = ThreadPoolExecutor(max_workers=2)
        self.net = ThreadPoolExecutor(max_workers=3)
        self.mem = OrderedDict()  # (url, size) -> pixbuf, the latest used last
        os.makedirs(CACHE, exist_ok=True)

    def get(self, url, image, size):
        if not url:
            return
        key = (url, size)
        pixbuf = self.mem.get(key)
        if pixbuf is not None:
            self.mem.move_to_end(key)
            image.set_from_pixbuf(pixbuf)
            return
        path = self.path(url)
        pool = self.disk if os.path.exists(path) else self.net
        pool.submit(self._load, url, path, key, image)

    @staticmethod
    def path(url):
        return os.path.join(CACHE, hashlib.sha1(url.encode()).hexdigest() + ".jpg")

    def file_uri(self, url):
        """The cover's file, if it is on disk already."""
        if url and os.path.exists(self.path(url)):
            return GLib.filename_to_uri(self.path(url), None)
        return None

    def _load(self, url, path, key, image):
        if not os.path.exists(path):
            try:
                req = urllib.request.Request(url, headers={"User-Agent": UA})
                with urllib.request.urlopen(req, timeout=20) as resp:
                    data = resp.read(512 * 1024)
                with open(path + ".new", "wb") as fh:
                    fh.write(data)
                os.replace(path + ".new", path)
            except OSError:
                return
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, key[1], key[1], True)
        except GLib.Error:
            return
        GLib.idle_add(self._show, key, pixbuf, image)

    def _show(self, key, pixbuf, image):
        self.mem[key] = pixbuf
        self.mem.move_to_end(key)
        while len(self.mem) > PIXBUFS:
            self.mem.popitem(last=False)
        image.set_from_pixbuf(pixbuf)
        return False


class Music(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.covers = Covers()
        self.settings = Settings("music")
        self.sources = sources.Sources(sources.load(), self.settings, CACHE, self.work,
                                       self.later, self.on_signed,
                                       lambda: self.update_hearts(), self.say)
        self.stale = False  # the pages are made anew on leaving the settings
        # Where one is: the section's root first, then what was opened in it.
        # A view is a dict; its page and widgets live in it while it is open.
        self.views = []
        self.roots = {}
        self.bar = None
        self.radio_view = None  # the page that shows the radio playing
        self.seeking = False
        self.win = None
        self.mpris = None  # what plays, told to the desktop
        events = SimpleNamespace(changed=self.on_track, grew=self.on_grew,
                                 playing=self.on_playing, time=self.on_time, failed=self.say)
        # The player keeps the machine awake while it plays, not paused.
        self.session = playback.Front(
            self.sources, lambda: sound.Player("Музыка", on_end=lambda: self.session.ended(),
                                           on_time=lambda s: self.session.timed(s),
                                           on_pause=lambda on: self.session.paused(on),
                                           on_error=self.session.ended),
            self.work, self.later, events)

    # --- the window ---------------------------------------------------------
    def do_activate(self):
        if self.win:
            self.win.present()
            return
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.win = Gtk.ApplicationWindow(application=self, title="Музыка")
        self.win.set_default_size(1160, 800)
        self.win.connect("delete-event", self.on_close)
        header = Gtk.HeaderBar(title="Музыка")
        header.set_show_close_button(not ON_HALTIA)
        self.back_btn = styled(Gtk.Button(label="←"), "back")
        self.back_btn.connect("clicked", lambda *_a: self.go_back())
        self.home_btn = styled(Gtk.Button.new_from_icon_name("go-home-symbolic",
                                                             Gtk.IconSize.DIALOG), "nav")
        self.home_btn.set_tooltip_text("Главная")
        self.home_btn.connect("clicked", lambda *_a: self.go_root("home"))
        self.browse_btn = styled(Gtk.Button(label="Обзор"), "nav")
        self.browse_btn.connect("clicked", lambda *_a: self.go_root("browse"))
        for btn in (self.back_btn, self.home_btn, self.browse_btn):
            btn.set_no_show_all(True)
            header.pack_start(btn)
        self.gear = styled(Gtk.Button.new_from_icon_name("emblem-system-symbolic",
                                                         Gtk.IconSize.DIALOG), "nav")
        self.gear.set_tooltip_text("Настройки")
        self.gear.connect("clicked", lambda *_a: self.open_settings())
        self.gear.set_no_show_all(True)
        header.pack_end(self.gear)
        # The source the pages show, the next one at a tap (as Видео's).
        self.source_btn = styled(Gtk.Button(), "nav")
        self.source_btn.connect("clicked", lambda *_a: self.show_next_source())
        self.source_btn.set_no_show_all(True)
        header.pack_end(self.source_btn)
        self.win.set_titlebar(header)

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        page = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12), "page")
        page.set_border_width(16)
        self.page = page
        outer.pack_start(page, True, True, 0)
        outer.pack_start(self.make_bar(), False, False, 0)
        self.win.add(outer)
        self.win.show_all()
        self.bar.hide()
        self.win.set_focus(None)
        if not self.sources.all():
            self.note_only("Нет ни одного музыкального сервиса.")
        else:
            self.show_main()
        try:
            self.mpris = mpris.Mpris(self.get_dbus_connection(), APP_ID, "Музыка",
                                     self.session, self.stop, self.win.present,
                                     lambda track: self.covers.file_uri(track.get("cover")))
        except (GLib.Error, AttributeError) as exc:  # no session bus: no MPRIS
            sys.stderr.write("haltia-music: no MPRIS: %s\n" % exc)

    def on_close(self, *_a):
        # Closing is meant: the music stops with the window.
        self.stop()
        return False

    def clear_page(self):
        self.drop_views()
        clear(self.page)

    def note_only(self, text):
        self.clear_page()
        label = styled(Gtk.Label(label=text), "note")
        label.set_line_wrap(True)
        self.page.pack_start(label, True, True, 0)
        self.page.show_all()

    def show_nav(self, on):
        for btn in (self.home_btn, self.browse_btn, self.gear):
            btn.set_visible(on)
        self.back_btn.set_visible(on and len(self.views) > 1)
        shown = self.sources.shown
        self.source_btn.set_label(shown.label if shown else "")
        self.source_btn.set_visible(on and len(self.sources.on()) > 1)

    # --- signing in -----------------------------------------------------------
    def signed_in(self, sid):
        return bool(sid) and self.sources.signin(sid)["kind"] == "in"

    def ask_sign_in(self, view):
        """Instead of a page of a source not signed in, or of none."""
        sid = view.get("src")
        if sid:
            text, label = ("Войдите в %s, чтобы слушать музыку."
                           % self.sources.get(sid).label, "Войти")
        else:
            text, label = "Включите источник музыки в настройках.", "Настройки"
        self.say(text, view)
        btn = styled(Gtk.Button(label=label), "login")
        btn.set_halign(Gtk.Align.CENTER)
        btn.connect("clicked", lambda *_a: self.open_settings(sid))
        view["box"].pack_start(btn, False, False, 8)
        btn.show()

    def on_signed(self, sid):
        """A source signed in or out, or a step of signing in."""
        self.stale = True
        view = self.settings_view()
        if view:
            self.fill_settings(view)
        elif sid == getattr(self.sources.shown, "id", None):
            self.remake_pages()

    def login_code(self, state):
        """The ways in of a source signing in: a QR code, a code to enter."""
        qr = state.get("qr") and qr_code(state["qr"], QR)
        ways = Gtk.Box(spacing=48)
        if qr:
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            col.set_valign(Gtk.Align.CENTER)
            col.pack_start(qr, False, False, 0)
            col.pack_start(styled(Gtk.Label(label="Наведите камеру телефона"), "note"),
                           False, False, 0)
            ways.pack_start(col, False, False, 0)
        if state.get("code"):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
            col.set_valign(Gtk.Align.CENTER)
            first = "или откройте" if qr else "На телефоне или компьютере откройте"
            url = state["url"].replace("https://", "")
            for text, cls in ((first, "note"), (url, "code"), ("и введите код", "note"),
                              (state["code"], "code")):
                col.pack_start(styled(Gtk.Label(label=text, xalign=0), cls), False, False, 0)
            ways.pack_start(col, False, False, 0)
        return ways

    def logout(self, src):
        if not dialogs.ask(self.win, "Выйти из %s?" % src.label, "Выйти"):
            return
        if self.session.current and self.session.current["source"] == src.id:
            self.stop()
        self.sources.sign_out(src.id)

    # --- the pages --------------------------------------------------------------
    def show_main(self):
        self.clear_page()
        row = Gtk.Box(spacing=12)
        self.entry = styled(Gtk.Entry(placeholder_text="Найти трек, исполнителя или плейлист"), "search")
        self.entry.connect("activate", lambda *_a: self.search())
        row.pack_start(self.entry, True, True, 0)
        self.find_btn = styled(Gtk.Button(label="Найти"), "find")
        self.find_btn.connect("clicked", lambda *_a: self.search())
        row.pack_start(self.find_btn, False, False, 0)
        self.page.pack_start(row, False, False, 0)
        # One page per open view, each scrolling as a whole: anything tall
        # outside the scrolled part keeps the window taller than the room the
        # on-screen keyboard leaves, and the window then covers its top row.
        self.stack = Gtk.Stack()
        self.page.pack_start(self.stack, True, True, 0)
        self.page.show_all()
        self.win.set_focus(None)
        shown = self.sources.shown
        if shown and self.signed_in(shown.id):
            self.sources.likes(shown.id).refresh()
        self.go_root("home")

    def remake_pages(self):
        """The pages of the source shown now, made anew."""
        self.stale = False
        self.drop_views()
        self.go_root("home")

    def show_next_source(self):
        self.sources.show_next()
        self.remake_pages()

    def drop_views(self):
        for view in self.views + list(self.roots.values()):
            self.drop(view)
        self.views, self.roots, self.radio_view = [], {}, None

    @staticmethod
    def drop(view):
        if view.get("alive"):
            view["alive"] = False
            view["page"].destroy()

    def go_root(self, section):
        if self.stale and self.settings_view():
            self.remake_pages()
            if section == "home":
                return
        root = self.roots.get(section)
        if root is not None and self.views == [root]:
            if section == "home":
                self.refresh_home(root)  # the house again: fresh rows
            return
        for view in self.views[1:]:
            self.drop(view)
        if root is None:
            root = self.roots[section] = ({"kind": "home"} if section == "home" else
                                          {"kind": "browse", "id": "", "title": "Обзор"})
            root["src"] = getattr(self.sources.shown, "id", None)
            self.views = [root]
            self.make_page(root)
        else:
            self.views = [root]
        self.show_top()

    def push(self, view):
        view.setdefault("src", self.views[-1].get("src") if self.views else None)
        self.views.append(view)
        self.make_page(view)
        self.show_top()

    def go_back(self):
        if self.stale and self.views[-1]["kind"] == "settings":
            self.remake_pages()
        elif len(self.views) > 1:
            self.drop(self.views.pop())
            self.show_top()

    def show_top(self):
        view = self.views[-1]
        self.stack.set_visible_child(view["page"])
        self.show_nav(True)
        root = self.views[0]["kind"]
        for btn, section in ((self.home_btn, "home"), (self.browse_btn, "browse")):
            ctx = btn.get_style_context()
            (ctx.add_class if root == section else ctx.remove_class)("current")
        self.update_hearts(view)
        self.mark_playing(view)

    def make_page(self, view):
        """Build the view's page into the stack and fill it."""
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        scroll.add(box)
        top = Gtk.Box(spacing=16)
        if view.get("title"):
            head = styled(Gtk.Label(label=view["title"], xalign=0), "head")
            head.set_ellipsize(Pango.EllipsizeMode.END)
            top.pack_start(head, True, True, 0)
        play = None
        if view["kind"] in ("list", "search", "radio"):
            play = styled(Gtk.Button(label="▶ Слушать"), "play")
            play.connect("clicked", lambda _b, v=view: self.listen(v))
            play.set_no_show_all(True)
            top.pack_end(play, False, False, 0)
        box.pack_start(top, False, False, 0)
        note = styled(Gtk.Label(), "note")
        note.set_line_wrap(True)
        note.set_no_show_all(True)
        box.pack_start(note, False, False, 8)
        lst = None
        if view["kind"] == "settings":
            self.settings_page(view, box)
        elif view["kind"] != "home":
            lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            lst.connect("row-activated", self.on_row, view)
            box.pack_start(lst, False, False, 0)
        more = None
        if view["kind"] == "radio":
            more = styled(Gtk.Label(label="Дальше радио подберёт новые треки само: они "
                                          "появятся внизу списка, пока оно играет.", xalign=0),
                          "note")
            more.set_line_wrap(True)
            more.set_no_show_all(True)
            box.pack_start(more, False, False, 8)
        view.update(page=scroll, box=box, note=note, list=lst, play=play, more=more, shown=[],
                    hearts=[], alive=True)
        self.stack.add(scroll)
        scroll.show_all()
        self.load_view(view)

    def say(self, text, view=None):
        view = view or (self.views[-1] if self.views else None)
        if view and view.get("alive"):
            view["note"].set_text(text)
            view["note"].set_visible(bool(text))

    def load_view(self, view):
        k = view["kind"]
        if k == "settings":
            return
        if not self.signed_in(view.get("src")):
            self.ask_sign_in(view)
            return
        src, answers = self.sources.get(view["src"]), self.sources.answers(view["src"])
        if k == "home":
            self.say("Загружаю…", view)
            answers.get("home", None, lambda rows, err: self._home(view, rows, err))
        elif k == "radio":
            if self.radio_on(view):
                self.radio_view = view
                self.fill(view, list(self.session.tracks))
            else:
                # Its first tracks, shown as a list's are; they play only when asked.
                self.say("Загружаю…", view)
                self.work(lambda r: src.radio_next(r, None), view["id"],
                          lambda tracks, err: self._radio_first(view, tracks, err))
        elif view.get("items") is not None:
            self._items(view, view["items"], None)
        else:
            what, arg = {"browse": ("browse", view.get("id")), "list": ("tracks", view.get("id")),
                         "search": ("search", view.get("query"))}[k]
            self.say("Ищу…" if k == "search" else "Загружаю…", view)
            answers.get(what, arg, lambda items, err: self._items(view, items, err))

    def _items(self, view, items, error):
        if view["kind"] == "search":
            self.find_btn.set_sensitive(True)
        if not view.get("alive"):
            return
        if error:
            self.say("Не удалось загрузить: нет связи или вход устарел.", view)
            return
        empty = "Ничего не найдено." if view["kind"] == "search" else "Здесь пока пусто."
        self.say("" if items else empty, view)
        self.fill(view, items)
        if view.get("focus"):
            self.focus(view, view.pop("focus"))

    def focus(self, view, track_id):
        """Scroll the page to the track and mark it, once it is laid out."""
        rows = [r for r in view["list"].get_children()
                if kind(view["shown"][r.track_index]) == "track"
                and view["shown"][r.track_index]["id"] == track_id]
        if not rows:
            return
        styled(rows[0], "focus")
        tries = [20]

        def scroll():
            if not view.get("alive"):
                return False
            pos = rows[0].translate_coordinates(view["box"], 0, 0)
            if (not pos or pos[1] <= 0) and tries[0] > 0:
                tries[0] -= 1
                return True
            view["page"].get_vadjustment().set_value(max(0, pos[1] - 8) if pos else 0)
            return False

        GLib.timeout_add(50, scroll)

    def search(self):
        query = self.entry.get_text().strip()
        if not query or not self.find_btn.get_sensitive():
            return
        self.win.set_focus(None)
        shown = self.sources.shown
        sid = shown.id if shown else None
        self.find_btn.set_sensitive(not self.signed_in(sid))
        self.push({"kind": "search", "query": query, "title": "Поиск: «%s»" % query,
                   "src": sid})

    def open_item(self, item, row=None, tracks=None):
        """Open what was tapped; music never starts from here."""
        k = kind(item)
        if k == "track":
            # A track on the home page opens its row's list at the track.
            view = {"kind": "list", "title": row["title"] if row else "", "focus": item["id"]}
            if row and row.get("list"):
                view["id"] = row["list"]
            else:
                view["items"] = tracks or [item]
            self.push(view)
        elif k == "radio":
            self.push({"kind": "radio", "id": item["id"], "title": item["title"]})
        else:
            self.push({"kind": "browse" if k == "folder" else "list",
                       "id": item["id"], "title": item["title"]})

    def listen(self, view):
        """«▶ Слушать»: a list from its first track, or the radio."""
        if view["kind"] == "radio":
            self.play_radio(view, 0)
            return
        tracks = [t for t in view["shown"] if kind(t) == "track"]
        if tracks:
            self.play_list(tracks, 0)

    # --- the settings -------------------------------------------------------------
    def open_settings(self, sign_in=None):
        """The settings; with sign_in, that source begins to sign in."""
        if self.views[-1]["kind"] != "settings":
            self.push({"kind": "settings", "title": "Настройки"})
        if sign_in and self.sources.signin(sign_in)["kind"] in ("out", "failed"):
            self.sources.sign_in(sign_in)

    def settings_view(self):
        view = self.views[-1] if self.views else None
        return view if view and view["kind"] == "settings" and view.get("alive") else None

    def settings_page(self, view, box):
        view["cards"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.pack_start(view["cards"], False, False, 0)
        self.fill_settings(view)

    def fill_settings(self, view):
        box = view["cards"]
        clear(box)
        box.pack_start(styled(Gtk.Label(label="Источники", xalign=0), "section"),
                       False, False, 0)
        for src in self.sources.all():
            box.pack_start(self.source_card(src), False, False, 0)
        view["choices"] = []
        many = len(self.sources.all()) > 1
        for src in self.sources.all():
            qualities = getattr(src, "qualities", None) or []
            if not qualities:
                continue
            title = "Качество звука" + (": %s" % src.label if many else "")
            box.pack_start(styled(Gtk.Label(label=title, xalign=0), "section"),
                           False, False, 8)
            for qid, name, hint in qualities:
                btn = styled(Gtk.Button(), "choice")
                row = Gtk.Box(spacing=16)
                text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                text.pack_start(styled(Gtk.Label(label=name, xalign=0), "ttl"), False, False, 0)
                text.pack_start(styled(Gtk.Label(label=hint, xalign=0), "sub"), False, False, 0)
                row.pack_start(text, True, True, 0)
                mark = styled(Gtk.Label(label="✓"), "mark")
                row.pack_end(mark, False, False, 0)
                btn.add(row)
                btn.connect("clicked", lambda _b, s=src.id, q=qid: self.set_quality(view, s, q))
                box.pack_start(btn, False, False, 0)
                view["choices"].append((src.id, qid, btn, mark))
        box.show_all()
        self.mark_quality(view)

    def source_card(self, src):
        """A source: switched on or off, its account, signing in and out."""
        state = self.sources.signin(src.id)
        card = styled(Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16), "account")
        top = Gtk.Box(spacing=16)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        text.set_valign(Gtk.Align.CENTER)
        text.pack_start(styled(Gtk.Label(label=src.label, xalign=0), "ttl"), False, False, 0)
        sub = {"in": state.get("name") or "Вход выполнен", "getting": "Подождите…",
               "waiting": "Жду подтверждения…", "form": "Вход не выполнен"}.get(
            state["kind"], state.get("note") or "Вход не выполнен")
        text.pack_start(styled(Gtk.Label(label=sub, xalign=0), "sub"), False, False, 0)
        top.pack_start(text, True, True, 0)
        if state["kind"] == "in":
            btn = styled(Gtk.Button(label="Выйти"), "quiet")
            btn.connect("clicked", lambda *_a: self.logout(src))
        elif state["kind"] in ("out", "failed"):
            btn = styled(Gtk.Button(label="Войти"), "quiet")
            btn.connect("clicked", lambda *_a: self.sources.sign_in(src.id))
        else:
            btn = None
        if btn:
            btn.set_valign(Gtk.Align.CENTER)
            top.pack_start(btn, False, False, 0)
        switch = Gtk.Switch(active=self.sources.is_on(src.id))
        switch.set_valign(Gtk.Align.CENTER)
        switch.connect("notify::active", lambda sw, _p: self.switch_source(src, sw.get_active()))
        top.pack_start(switch, False, False, 0)
        card.pack_start(top, False, False, 0)
        if state["kind"] == "waiting":
            card.pack_start(self.login_code(state), False, False, 0)
        elif state["kind"] == "form":
            card.pack_start(self.login_form(src, state), False, False, 0)
        return card

    def login_form(self, src, state):
        """The fields a source asks for to sign in, and «Войти»."""
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        if state.get("note"):
            note = styled(Gtk.Label(label=state["note"], xalign=0), "sub")
            note.set_line_wrap(True)
            box.pack_start(note, False, False, 0)
        entries = {}
        for field in state["fields"]:
            box.pack_start(styled(Gtk.Label(label=field["label"], xalign=0), "sub"),
                           False, False, 0)
            entry = styled(Gtk.Entry(text=field.get("value") or ""), "search")
            entry.set_visibility(not field.get("secret"))
            if field.get("choices"):
                row = Gtk.Box(spacing=8)
                for value, label in field["choices"]:
                    btn = styled(Gtk.Button(label=label), "quiet")
                    btn.connect("clicked", lambda _b, e=entry, v=value: e.set_text(v))
                    row.pack_start(btn, False, False, 0)
                box.pack_start(row, False, False, 0)
            box.pack_start(entry, False, False, 0)
            entries[field["id"]] = entry
        btn = styled(Gtk.Button(label="Войти"), "login")
        btn.set_halign(Gtk.Align.START)

        def send(*_a):
            self.win.set_focus(None)
            self.sources.send(src.id, {fid: e.get_text() if self._secret(state, fid)
                                       else e.get_text().strip()
                                       for fid, e in entries.items()})

        for entry in entries.values():
            entry.connect("activate", send)
        btn.connect("clicked", send)
        box.pack_start(btn, False, False, 0)
        return box

    @staticmethod
    def _secret(state, fid):
        return any(f["id"] == fid and f.get("secret") for f in state["fields"])

    def switch_source(self, src, on):
        if self.sources.switch(src.id, on):
            self.stale = True

    def mark_quality(self, view):
        for sid, qid, btn, mark in view["choices"]:
            now = qid == self.sources.quality(sid)
            ctx = btn.get_style_context()
            (ctx.add_class if now else ctx.remove_class)("current")
            mark.set_opacity(1 if now else 0)

    def set_quality(self, view, sid, quality):
        if quality == self.sources.quality(sid):
            return
        self.sources.set_quality(sid, quality)
        self.mark_quality(view)
        if self.session.current and self.session.current["source"] == sid:
            self.say("Новое качество — со следующего трека.", view)

    # --- the home page --------------------------------------------------------
    def _home(self, view, rows, error):
        if not view.get("alive"):
            return
        if error or not rows:
            self.say("Не удалось загрузить: нет связи или вход устарел.", view)
            return
        self.say("", view)
        if view.get("rows") == rows:
            return
        for section in view.get("sections", {}).values():
            section.destroy()
        view["rows"], view["sections"], view["shows"] = rows, {}, {}
        for row in rows:
            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            section.set_no_show_all(True)
            section.pack_start(styled(Gtk.Label(label=row["title"], xalign=0), "rowtitle"),
                               False, False, 0)
            strip = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER)
            cards = Gtk.Box(spacing=12)
            strip.add(cards)
            section.pack_start(strip, False, False, 0)
            view["box"].pack_start(section, False, False, 4)
            view["sections"][row["id"]] = section
            show = view["shows"][row["id"]] = (
                lambda items, err, r=row, s=section, c=cards: self._home_row(view, r, s, c,
                                                                            items, err))
            self.sources.answers(view["src"]).get("home_row", row["id"], show)

    def refresh_home(self, view):
        view["page"].get_vadjustment().set_value(0)
        if not self.signed_in(view.get("src")):
            return
        self.sources.likes(view["src"]).refresh(force=True)
        for row in view.get("rows") or []:
            self.sources.answers(view["src"]).get("home_row", row["id"],
                                                  view["shows"][row["id"]], force=True)

    def _home_row(self, view, row, section, cards, items, error):
        if not view.get("alive") or error or view["sections"].get(row["id"]) is not section:
            return  # the rows were made anew meanwhile
        clear(cards)
        if not items:
            section.hide()
            return
        tracks = [i for i in items if kind(i) == "track"]
        for item in items:
            btn = styled(Gtk.Button(), "card")
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.cover(item, CARD, 56, view.get("src")), False, False, 0)
            ttl = styled(Gtk.Label(label=item["title"], xalign=0), "ttl")
            ttl.set_line_wrap(True)
            ttl.set_lines(2)
            ttl.set_ellipsize(Pango.EllipsizeMode.END)
            ttl.set_max_width_chars(1)
            ttl.set_size_request(CARD, -1)
            box.pack_start(ttl, False, False, 0)
            sub_text = item.get("artist") if kind(item) == "track" else item.get("subtitle")
            if sub_text:
                sub = styled(Gtk.Label(label=sub_text, xalign=0), "sub")
                sub.set_ellipsize(Pango.EllipsizeMode.END)
                sub.set_max_width_chars(1)
                box.pack_start(sub, False, False, 0)
            btn.add(box)
            btn.connect("clicked", lambda _b, i=item: self.open_item(i, row, tracks))
            cards.pack_start(btn, False, False, 0)
        section.set_no_show_all(False)
        section.show_all()

    def cover(self, item, size, glyph_px, src):
        if item.get("cover"):
            image = Gtk.Image()
            image.set_size_request(size, size)
            self.covers.get(item["cover"], image, size)
            return image
        # A radio with a sign of its own gets a colour of its own, the same
        # each time; Мне нравится is red.
        likes_list = getattr(self.sources.get(src), "likes_list", None)
        tint = "like" if likes_list and item.get("id") == likes_list else (
            "c%d" % (sum(map(ord, item["id"])) % 6) if kind(item) == "radio" and item.get("glyph")
            else kind(item))
        box = styled(Gtk.Box(), "nocover", tint)
        box.set_size_request(size, size)
        label = Gtk.Label()
        label.set_markup('<span size="%d">%s</span>'
                         % (glyph_px * 768, item.get("glyph") or GLYPHS[kind(item)]))
        box.set_center_widget(label)
        return box

    # --- the lists --------------------------------------------------------------
    def fill(self, view, items):
        view["shown"] = items
        view["hearts"] = []
        clear(view["list"])
        self.add_rows(view, items, 0)
        if view["play"] is not None:
            has_tracks = any(kind(t) == "track" for t in items)
            view["play"].set_visible(has_tracks and not (view["kind"] == "radio"
                                                         and self.radio_on(view)))
        if view.get("more") is not None:
            view["more"].set_visible(bool(items))
        self.update_hearts(view)
        self.mark_playing(view)

    def add_rows(self, view, items, first):
        """Rows for items, the first of them shown[first]."""
        lst = view["list"]
        for i, t in enumerate(items, first):
            row = Gtk.ListBoxRow()
            row.track_index = i
            box = Gtk.Box(spacing=16)
            box.pack_start(self.cover(t, 64, 28, view.get("src")), False, False, 0)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            text.set_valign(Gtk.Align.CENTER)
            ttl = styled(Gtk.Label(label=t["title"], xalign=0), "ttl")
            ttl.set_ellipsize(Pango.EllipsizeMode.END)
            text.pack_start(ttl, False, False, 0)
            sub_text = t.get("artist") if kind(t) == "track" else t.get("subtitle")
            if sub_text:
                sub = styled(Gtk.Label(label=sub_text, xalign=0), "sub")
                sub.set_ellipsize(Pango.EllipsizeMode.END)
                text.pack_start(sub, False, False, 0)
            box.pack_start(text, True, True, 0)
            if kind(t) == "track":
                dur = styled(Gtk.Label(label=mmss(t.get("duration"))), "sub")
                box.pack_start(dur, False, False, 0)
                if self.likes_of(t).able:
                    heart = styled(Gtk.Button(), "heart")
                    heart.set_valign(Gtk.Align.CENTER)
                    heart.connect("clicked", lambda _b, tr=t: self.likes_of(tr).toggle(tr))
                    view["hearts"].append((heart, t))
                    box.pack_start(heart, False, False, 0)
            else:
                more = styled(Gtk.Label(label="▶" if kind(t) == "radio" else "›"), "more")
                box.pack_start(more, False, False, 8)
            row.add(box)
            lst.add(row)
        lst.show_all()

    def radio_on(self, view):
        return (view["kind"] == "radio" and self.session.radio == view.get("id")
                and getattr(self.session.radio_src, "id", None) == view.get("src")
                and bool(self.session.tracks))

    def on_row(self, _list, row, view):
        i = row.track_index
        item = view["shown"][i]
        if kind(item) != "track":
            self.open_item(item)
            return
        if view["kind"] == "radio":
            self.play_radio(view, i)
            return
        # A tap on a track plays the list's tracks from this one on.
        tracks = [t for t in view["shown"] if kind(t) == "track"]
        before = sum(1 for t in view["shown"][:i] if kind(t) == "track")
        self.play_list(tracks, before)

    def open_views(self, view=None):
        return [view] if view else [v for v in self.views if v.get("alive")]

    def mark_playing(self, view=None):
        current = self.session.current
        for v in self.open_views(view):
            if not v.get("list"):
                continue
            for row in v["list"].get_children():
                t = v["shown"][row.track_index] if row.track_index < len(v["shown"]) else None
                same = (current and t and kind(t) == "track" and t["id"] == current["id"]
                        and t["source"] == current["source"])
                ctx = row.get_style_context()
                (ctx.add_class if same else ctx.remove_class)("playing")

    # --- what one likes ---------------------------------------------------------
    def likes_of(self, track):
        """The hearts of the track's source; none for a source gone."""
        sid = track["source"] if track else None
        return self.sources.likes(sid) if self.sources.get(sid) else NO_LIKES

    def set_heart(self, btn, track):
        on = self.likes_of(track).liked(track)
        btn.set_label("♥" if on else "♡")
        ctx = btn.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("on")

    def update_hearts(self, view=None):
        for v in self.open_views(view):
            for btn, track in v.get("hearts", []):
                self.set_heart(btn, track)
        if self.bar:
            current = self.session.current
            self.bar_heart.set_visible(self.likes_of(current).able)
            self.set_heart(self.bar_heart, current)

    # --- the bar ----------------------------------------------------------------
    def make_bar(self):
        bar = styled(Gtk.Box(spacing=16), "bar")
        self.bar_cover = Gtk.Image()
        self.bar_cover.set_size_request(96, 96)
        bar.pack_start(self.bar_cover, False, False, 0)
        mid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        self.bar_title = styled(Gtk.Label(xalign=0), "ttl")
        self.bar_title.set_ellipsize(Pango.EllipsizeMode.END)
        self.bar_artist = styled(Gtk.Label(xalign=0), "sub")
        self.bar_artist.set_ellipsize(Pango.EllipsizeMode.END)
        mid.pack_start(self.bar_title, False, False, 0)
        mid.pack_start(self.bar_artist, False, False, 0)
        line = Gtk.Box(spacing=8)
        self.bar_pos = styled(Gtk.Label(label="0:00"), "time")
        self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 1, 1)
        self.scale.set_draw_value(False)
        self.scale.connect("button-press-event", lambda *_a: setattr(self, "seeking", True))
        self.scale.connect("button-release-event", self.on_seek)
        self.bar_len = styled(Gtk.Label(label="0:00"), "time")
        line.pack_start(self.bar_pos, False, False, 0)
        line.pack_start(self.scale, True, True, 0)
        line.pack_start(self.bar_len, False, False, 0)
        mid.pack_start(line, False, False, 0)
        bar.pack_start(mid, True, True, 0)
        self.bar_heart = styled(Gtk.Button(label="♡"), "heart")
        self.bar_heart.set_valign(Gtk.Align.CENTER)
        self.bar_heart.connect("clicked", lambda *_a: self.likes_of(
            self.session.current).toggle(self.session.current))
        self.bar_heart.set_no_show_all(True)
        bar.pack_start(self.bar_heart, False, False, 0)
        for label, cls, cb in (("⏮", "ctl", self.session.prev),
                               ("▶", "ctl main", self.session.toggle),
                               ("⏭", "ctl", self.session.next)):
            btn = styled(Gtk.Button(label=label), *cls.split())
            btn.set_valign(Gtk.Align.CENTER)
            btn.connect("clicked", lambda *_a, f=cb: f())
            bar.pack_start(btn, False, False, 0)
            if "main" in cls:
                self.play_btn = btn
        self.bar = bar
        return bar

    def on_seek(self, *_a):
        self.seeking = False
        self.session.seek(self.scale.get_value())
        return False

    # --- playing ----------------------------------------------------------------
    def play_list(self, tracks, i):
        self.radio_view = None
        self.session.play_list(tracks, i)
        for view in self.open_views():
            if view["kind"] == "radio":
                view["play"].show()

    def _radio_first(self, view, tracks, error):
        if not view.get("alive") or self.radio_on(view):
            return
        if error or not tracks:
            self.say("Радио не загрузилось: нет связи?", view)
            return
        self.say("", view)
        self.fill(view, list(tracks))

    def play_radio(self, view, i):
        """Play the radio of the page from its i-th track; what comes next
        is added to the page as it comes."""
        if self.radio_on(view):
            self.session.jump(i)
            return
        if not view["shown"]:
            return
        self.radio_view = view
        self.session.play_radio(view["id"], view["shown"], i)
        view["play"].hide()

    def on_track(self, track):
        if self.mpris:
            self.mpris.changed()
        if track is None:
            if self.bar:
                self.bar.hide()
            return
        self.bar.show()
        self.bar_title.set_text(track["title"])
        self.bar_artist.set_text(track["artist"])
        duration = track.get("duration") or 0
        self.scale.set_range(0, max(1, duration))
        self.bar_len.set_text(mmss(duration))
        self.bar_pos.set_text("0:00")
        self.bar_cover.clear()
        self.covers.get(track.get("cover"), self.bar_cover, 96)
        self.mark_playing()
        self.update_hearts()

    def on_grew(self, tracks):
        view = self.radio_view
        if view and view.get("alive") and self.radio_on(view):
            first = len(view["shown"])
            view["shown"].extend(tracks)
            self.add_rows(view, tracks, first)
            self.update_hearts(view)

    def on_time(self, value):
        if value is None:
            return False
        if not self.seeking:
            self.scale.set_value(value)
        self.bar_pos.set_text(mmss(value))
        return False

    def on_playing(self, on):
        if self.mpris:
            self.mpris.changed()
        if self.bar:
            self.play_btn.set_label("⏸" if on else "▶")

    def stop(self):
        self.session.stop()
        self.radio_view = None

    def do_shutdown(self):
        for src in self.sources.all():
            self.sources.answers(src.id).flush()
        Gtk.Application.do_shutdown(self)

    # --- background work -------------------------------------------------------
    def later(self, sec, func):
        GLib.timeout_add(int(sec * 1000), lambda: (func(), False)[1])

    def work(self, func, arg, done):
        """func(arg) in a thread; done(result, error) back on the GTK side."""

        def worker():
            try:
                res, err = func(arg), None
            except Exception as exc:
                sys.stderr.write("haltia-music: %s\n" % exc)
                res, err = None, exc
            if done:
                GLib.idle_add(lambda: (done(res, err), False)[1])

        threading.Thread(target=worker, daemon=True).start()


if __name__ == "__main__":
    # b8k-music before 2.0: the login, the kept answers and covers move once.
    paths.migrate_dirs("b8k-music", "haltia-music")
    sys.exit(Music().run(sys.argv))
